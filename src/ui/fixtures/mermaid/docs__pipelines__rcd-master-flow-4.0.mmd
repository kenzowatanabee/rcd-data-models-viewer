flowchart TD
    subgraph Input_Retailers ["Retailer Sales Data (18 unioned; RCD_T1_SAVEGNAGO loaded but not connected)"]
        R1[RCD_T1_ATACADAO NORTE]
        R2[RCD_ATACADÃO]
        R3[RCD_T1_SÃO_VICENTE]
        R5[RCD_T2_GPA]
        R6[RCD_T2_ANGELONI]
        R7[RCD_T2_CONDOR]
        R8[RCD_T2_GIASSI]
        R9[RCD_T2_MUFFATO]
        R10[RCD_T2_REDE TOP]
        R11[RCD_T3_D1000]
        R12[RCD_T3_DROGAL]
        R13[RCD_T3_DPSP]
        R14[RCD_T3_DROG PAGUEMENOS]
        R15[RCD_T3_PANVEL]
        R16[RCD_T3_VENANCIO]
        R17[RCD_T3_GLOBO]
        R18[RCD_T3_INDIANA]
        R19[RCD_T3_ARAUJO]
    end

    subgraph Input_Special ["Special, Market & Recommendation Inputs"]
        S1[RCD_SCANTECH]
        RD1[RCD_T3_RD ESTADO]
        RD2[RCD_T3_RD CLUSTER]
        L1[RCD_MASTER_STORES]
        L2[RCD_MASTER_PRODUCT]
        L3[RCD_PARA_RETIRAR]
        L4[DE PARA RD]
        M1[RCD_TAB_MKT_P_MASTER_FLOW]
        M2[RCD_TAB_IQVIA_P_MASTER_FLOW]
        CP[RCD LANÇAMENTOS CP]
        SR[RCD_SORT_REC_NACIONAL]
    end

    Input_Retailers -->|Union| APPEND_TORRES[APPEND_TORRES]
    APPEND_TORRES -->|SALES_VALUE & SALES_VOL NOT NULL| FILT_SALES[FILTRO SALES]
    FILT_SALES -->|Add Constants FONTE_DADOS='CUSTOMER'| CONST_RETAIL[FONTE DADOS]
    S1 -->|Select Columns 4| SCAN_SEL[Select Columns 4]
    SCAN_SEL -->|FONTE_DADOS_2='SCANNTECH'| SCAN_CONST[FONTE DADOS 2]
    CONST_RETAIL --> APP_MAIN_1[Append Rows 2]
    SCAN_CONST --> APP_MAIN_1
    APP_MAIN_1 -->|SALES_VOL -> SALES_UNIT, DESC_SKU -> CONF_DESC_SKU| REN_1[RENOMEAR UNITS E CONF_DESC]
    REN_1 -->|LPAD Store, UPPER Customer/Banner, Trim EAN| PAD_1[PADRONIZAÇÕES EAN TIRA 0 DA ESQUERDA]
    PAD_1 -->|Set Constant DN=1| DN_1[ADD DN]

    RD1 --> TAB_RD_EST[TABELA RD ESTADO]
    RD2 --> TAB_RD_CLUS[TABELA RD CLUSTER 1]
    TAB_RD_EST -->|Group By YYYYMM, STORE_COD: Max LOJAS VENDENDO| GRP_RD1[Group By]
    TAB_RD_EST -->|Left Join YYYYMM, STORE_COD| JOIN_RD1[Join Data 1]
    GRP_RD1 --> JOIN_RD1
    JOIN_RD1 -->|DN = LOJAS VENDENDO / LOJAS VENDENDO MAX MES| FORM_RD1[Add Formula 1]
    TAB_RD_CLUS -->|Group By YYYYMM, STORE_COD: Max LOJAS VENDENDO| GRP_RD2[Group By 3]
    TAB_RD_CLUS -->|Left Join YYYYMM only: fan-out, Q39| JOIN_RD2[Join Data 2]
    GRP_RD2 --> JOIN_RD2
    JOIN_RD2 -->|DN = LOJAS VENDENDO / LOJAS VENDENDO MAX MES| FORM_RD2[Add Formula 4]
    FORM_RD1 --> SEL_RD1[Select Columns 2]
    FORM_RD2 --> SEL_RD2[Select Columns 3]
    SEL_RD1 --> APP_RD[Append Rows 1]
    SEL_RD2 --> APP_RD
    APP_RD -->|Add Constants FONTE_DADOS_2='CUSTOMER'| CONST_RD[FONTE DADOS 1]
    CONST_RD -->|Left Join EAN = prod_code| JOIN_DEPARA[Join Data 3]
    L4 --> JOIN_DEPARA
    JOIN_DEPARA -->|EAN_DEPARA Case Expression| EAN_MAP[Add Formula 5]
    EAN_MAP --> SEL_RD5[Select Columns 5] --> PAD_RD[PADRONIZAÇÕES EAN TIRA 0 DA ESQUERDA 1]

    DN_1 --> APP_STORE_STREAM[Append Rows]
    PAD_RD --> APP_STORE_STREAM
    L1 -->|LPAD STORE_COD| PAD_STORE_COD[PADRONIZAÇÃO STORE COD]
    APP_STORE_STREAM -->|Left Join CUSTOMER, BANNER, STORE_COD| JOIN_STORES[JOIN MASTER LOJAS]
    PAD_STORE_COD --> JOIN_STORES
    JOIN_STORES --> MAIN_DATES[DATAS 3]
    MAIN_DATES --> FILT_DATE[FILTRO DATA]
    FILT_DATE --> MAIN_QTR[QUARTER]
    MAIN_QTR --> GRP_LOJAS[COUNT LOJAS]
    MAIN_QTR --> JOIN_LOJAS_CNT[Juntar dados 3]
    GRP_LOJAS -->|QUANTIDADE LOJAS = COUNT DISTINCT STORE_COD| JOIN_LOJAS_CNT
    JOIN_LOJAS_CNT -->|DP=1, CATEGORY_NIELSEN=NULL| DP_CONST[DISTRIBUIÇÃO NUMÉRICA]

    L2 --> REM_DUP_PROD[Remove Duplicates]
    DP_CONST -->|Left Join EAN| JOIN_PROD[JOIN MASTER PRODUCT]
    REM_DUP_PROD --> JOIN_PROD
    L3 --> CONST_EXCL[CONSTANTE EXCLUIR]
    JOIN_PROD -->|Left Join EAN| JOIN_RETIRAR[JOIN PARA RETIRAR]
    CONST_EXCL --> JOIN_RETIRAR
    JOIN_RETIRAR --> RENAME_YM[RENOMEAR YYYYMM PARA YM]
    RENAME_YM -->|EXCLUIR IS NULL| EXCL_EANS[EXCLUIR EANS]
    EXCL_EANS --> SEL_COL1[Select Columns 1]

    M1 --> MKT_DATE[ADD MONTH_NAME]
    MKT_DATE --> MKT_CONST[Adicionar constantes 1]
    SEL_COL1 --> APP_MKT[APPEND TAB BASE MKT]
    MKT_CONST --> APP_MKT
    M2 --> APP_MKT

    APP_MKT --> FILT_SAN[FILTRO SANITIZER]
    FILT_SAN --> FORM_ORIG[FORMULA ORIGEM_DADOS]
    FORM_ORIG --> FILT_NULL[FILTRO IS NOT NULL]

    CP --> SEL_CP["Select Columns: Lauch_Type->TYPE_LAUNCH, Lauch_Quarter->QUARTER"]
    SEL_CP --> DUP_CP[Remover duplicados by EAN]
    FILT_NULL -->|Left Join EAN, QUARTER| JOIN_CP[Juntar dados]
    DUP_CP --> JOIN_CP

    SR -->|Unpivot Channels into CANAL & REC_RETAIL| UNPIV_SR[Remover rotação]
    JOIN_CP -->|Full Outer Join EAN, CANAL| JOIN_SR[Juntar dados 2]
    UNPIV_SR --> JOIN_SR

    JOIN_SR --> FORM_VOL["Adicionar fórmula: SALES_VOL, TYPE_LAUNCH, EAN"]
    FORM_VOL --> SUB_CAT[SUB CAT INTERNA]
    SUB_CAT --> REP_CANAL["Replace Text: CANAL TOTAL RE -> TOTAL BRASIL"]
    REP_CANAL --> DUP_FINAL[Remove Duplicates 1]
    DUP_FINAL --> OUT_MART[(RCD_TAB_MKT_CUSTOMER_COMPLETO)]
