flowchart TD
    subgraph Input_Retailers ["Retailer Sales Data (18 unioned; RCD_ATACADÃO is loaded but not connected)"]
        R1[RCD_T1_ATACADAO NORTE]
        R3[RCD_T1_SÃO_VICENTE]
        R4[RCD_T1_SAVEGNAGO]
        R5[RCD_T2_GPA]
        R6[RCD_T2_ANGELONI]
        R7[RCD_T2_CONDOR]
        R8[RCD_T2_GIASSI]
        R9[RCD_T2_MUFFATO]
        R10[RCD_T2_REDE TOP]
        R11[RCD_T3_D1000]
        R12[RCD_T3_DROGAL]
        R13[RCD_T3_DPSP]
        R14[RCD_T3_DROG PAGUEMENOS]
        R15[RCD_T3_PANVEL]
        R16[RCD_T3_VENANCIO]
        R17[RCD_T3_GLOBO]
        R18[RCD_T3_INDIANA]
        R19[RCD_T3_ARAUJO]
    end

    subgraph Input_Special ["Special & Master Inputs"]
        S1[RCD_SCANTECH]
        RD1[RCD_T3_RD ESTADO]
        RD2[RCD_T3_RD CLUSTER]
        L1[RCD_MASTER_STORES]
        L2[RCD_MASTER_PRODUCT]
        L3[RCD_PARA_RETIRAR]
        L4[DE PARA RD]
        L5[RCD_TAB_MKT_P_MASTER_FLOW]
    end

    Input_Retailers -->|Union| APPEND_TORRES[APPEND_TORRES]
    APPEND_TORRES -->|YYYYMM >= 202201 & SALES_VALUE > 0 & NOT NULL| FILT_SALES[FILTRO SALES]
    FILT_SALES -->|Add Constants FONTE_DADOS='CUSTOMER'| CONST_RETAIL[FONTE DADOS]
    S1 -->|Select Columns 4| SCAN_SEL[Select Columns 4]
    SCAN_SEL -->|FONTE_DADOS_2='SCANNTECH'| SCAN_CONST[Add Constants]
    CONST_RETAIL --> APP_MAIN_1[Append Rows 2]
    SCAN_CONST --> APP_MAIN_1
    APP_MAIN_1 -->|SALES_VOL -> SALES_UNIT, DESC_SKU -> CONF_DESC_SKU| REN_1[RENOMEAR UNITS E CONF_DESC]
    REN_1 -->|LPAD Store, UPPER Customer/Banner, Trim EAN| PAD_1[PADRONIZAÇÕES EAN TIRA 0 DA ESQUERDA]
    PAD_1 -->|Set Constant DN=1| DN_1[DISTRIBUIÇÃO NUMÉRICA E PONDERADA 1]

    RD1 --> TAB_RD_EST[TABELA RD ESTADO]
    RD2 --> TAB_RD_CLUS[TABELA RD CLUSTER 1]
    TAB_RD_EST -->|Group By YYYYMM, STORE_COD: Max LOJAS VENDENDO| GRP_RD1[Group By]
    TAB_RD_EST -->|Inner Join YYYYMM, STORE_COD| JOIN_RD1[Join Data 1]
    GRP_RD1 --> JOIN_RD1
    JOIN_RD1 -->|DN = LOJAS VENDENDO / LOJAS VENDENDO MAX MES| FORM_RD1[Add Formula]
    TAB_RD_CLUS -->|MAX per YYYYMM, STORE_COD, then SUM per YYYYMM| GRP_RD2[Group By 1 + Group By 2]
    TAB_RD_CLUS -->|Left Join YYYYMM| JOIN_RD2[Join Data 2]
    GRP_RD2 --> JOIN_RD2
    JOIN_RD2 -->|DN = LOJAS VENDENDO / LOJAS VENDENDO TOTAL BRASIL| FORM_RD2[Add Formula 1]
    FORM_RD1 --> SEL_RD1[Select Columns 2]
    FORM_RD2 --> SEL_RD2[Select Columns 3]
    SEL_RD1 --> APP_RD[Append Rows 1]
    SEL_RD2 --> APP_RD
    APP_RD -->|Add Constants FONTE_DADOS_2='CUSTOMER'| CONST_RD[FONTE DADOS 1]
    CONST_RD -->|Left Join EAN = prod_code| JOIN_DEPARA[Join Data 3]
    L4 --> JOIN_DEPARA
    JOIN_DEPARA -->|EAN_DEPARA Case Expression| EAN_MAP[Add Formula 5]
    EAN_MAP --> SEL_RD5[Select Columns 5]
    SEL_RD5 --> PAD_RD[PADRONIZAÇÕES EAN TIRA 0 DA ESQUERDA 1]

    DN_1 --> APP_STORE_STREAM[Append Rows]
    PAD_RD --> APP_STORE_STREAM
    L1 -->|LPAD STORE_COD| PAD_STORE_COD[PADRONIZAÇÃO STORE COD]
    APP_STORE_STREAM -->|Left Join CUSTOMER, BANNER, STORE_COD| JOIN_STORES[JOIN MASTER LOJAS]
    PAD_STORE_COD --> JOIN_STORES

    JOIN_STORES --> MAIN_DATES[DATAS]
    MAIN_DATES --> MAIN_QTR[QUARTER]
    MAIN_QTR --> GRP_LOJAS[COUNT LOJAS]
    MAIN_QTR --> JOIN_LOJAS_CNT[Join Data: inner]
    GRP_LOJAS -->|QUANTIDADE LOJAS = COUNT DISTINCT STORE_COD| JOIN_LOJAS_CNT
    JOIN_LOJAS_CNT -->|DP=1, CATEGORY_NIELSEN=NULL| DP_CONST[DISTRIBUIÇÃO NUMÉRICA E PONDERADA]

    L2 --> REM_DUP_PROD[Remove Duplicates]
    DP_CONST -->|Left Join EAN| JOIN_PROD[JOIN MASTER PRODUCT]
    REM_DUP_PROD --> JOIN_PROD
    L3 --> CONST_EXCL[CONSTANTE EXCLUIR]
    JOIN_PROD -->|Left Join EAN| JOIN_RETIRAR[JOIN PARA RETIRAR]
    CONST_EXCL --> JOIN_RETIRAR
    JOIN_RETIRAR --> RENAME_YM[RENOMEAR YYYYMM PARA YM]
    RENAME_YM -->|EXCLUIR IS NULL| EXCL_EANS[EXCLUIR EANS]
    EXCL_EANS --> SEL_COL1[Select Columns 1]
    SEL_COL1 --> SUB_CAT_INT[SUB_CAT_INTERNA]

    L5 --> MKT_DATE[ADD MONTH_NAME]
    MKT_DATE --> MKT_CONST[FONTE DE DADOS]
    SUB_CAT_INT --> APP_MKT[APPEND TAB BASE MKT]
    MKT_CONST --> APP_MKT

    APP_MKT --> ORIGEM_FORM[FORMULA ORIGEM_DADOS]
    ORIGEM_FORM --> REM_DUP_1[Remove Duplicates 1]
    REM_DUP_1 --> FILT_NULL[FILTRO IS NOT NULL]
    FILT_NULL --> FILT_2YRS[FILTRAR OS DOIS ULTIMOS ANOS]
    FILT_2YRS --> FILT_SAN[Filter SANITIZER]
    FILT_SAN --> SEL_FINAL[Select Columns]
    SEL_FINAL --> REP_CANAL[Replace Text]
    REP_CANAL --> SCORECARD_OUT[(RCD_TAB_SCORECARD)]
