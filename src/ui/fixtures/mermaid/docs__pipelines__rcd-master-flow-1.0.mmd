flowchart TD
    subgraph Input_Retailers ["Retailer Sales Data (19 Inputs)"]
        R1[RCD_T1_ATACADAO NORTE]
        R2[RCD_ATACADÃO]
        R3[RCD_T1_SÃO_VICENTE]
        R4[RCD_T1_SAVEGNAGO]
        R5[RCD_T2_GPA]
        R6[RCD_T2_ANGELONI]
        R7[RCD_T2_CONDOR]
        R8[RCD_T2_GIASSI]
        R9[RCD_T2_MUFFATO]
        R10[RCD_T2_REDE TOP]
        R11[RCD_T3_D1000]
        R12[RCD_T3_DROGAL]
        R13[RCD_T3_DPSP]
        R14[RCD_T3_DROG PAGUEMENOS]
        R15[RCD_T3_PANVEL]
        R16[RCD_T3_VENANCIO]
        R17[RCD_T3_GLOBO]
        R18[RCD_T3_INDIANA]
        R19[RCD_T3_ARAUJO]
    end

    subgraph Input_Special ["Special & Master Inputs"]
        S1[RCD_SCANTECH]
        RD1[RCD_T3_RD ESTADO]
        RD2[RCD_T3_RD CLUSTER]
        L1[RCD_MASTER_STORES]
        L2[RCD_MASTER_PRODUCT]
        L3[RCD_PARA_RETIRAR]
        L4[DE PARA RD]
    end

    %% Ingestion & padding
    Input_Retailers -->|Union| UNION_RETAIL[APPEND_TORRES]
    UNION_RETAIL -->|Filter NOT NULL Sales| FILT_SALES[FILTRO SALES]
    FILT_SALES -->|Add Constants FONTE_DADOS='CUSTOMER'| CONST_RETAIL[FONTE DADOS]
    S1 -->|Select Columns| SCAN_SEL[Select Columns 4]
    SCAN_SEL -->|FONTE_DADOS_2='SCANNTECH'| SCAN_CONST[Add Constants]
    CONST_RETAIL --> APP_MAIN_1[Append Rows 2]
    SCAN_CONST --> APP_MAIN_1
    APP_MAIN_1 -->|Rename SALES_VOL->SALES_UNIT, DESC_SKU->CONF_DESC_SKU| REN_1[RENOMEAR UNITS E CONF_DESC]
    REN_1 -->|LPAD Store, UPPER Customer/Banner, Trim EAN| PAD_1[PADRONIZAÇÕES EAN TIRA 0 DA ESQUERDA]
    PAD_1 -->|Add DN=1| DN_1[ADD DN]

    %% RD branch
    RD1 --> TAB_RD_EST[TABELA RD ESTADO]
    RD2 --> TAB_RD_CLUS[TABELA RD CLUSTER 1]
    TAB_RD_EST -->|Max LOJAS VENDENDO per YYYYMM| GRP_RD1[Group By]
    TAB_RD_CLUS -->|Max LOJAS VENDENDO per YYYYMM| GRP_RD2[Group By 1]
    TAB_RD_EST -->|Left Join YYYYMM| JOIN_RD1[Join Data]
    GRP_RD1 --> JOIN_RD1
    JOIN_RD1 -->|DN = LOJAS VENDENDO / MAX| FORM_RD1[Add Formula]
    TAB_RD_CLUS -->|Left Join YYYYMM| JOIN_RD2[Join Data 2]
    GRP_RD2 --> JOIN_RD2
    JOIN_RD2 -->|DN = LOJAS VENDENDO / MAX| FORM_RD2[Add Formula 1]
    FORM_RD1 --> SEL_RD1[Select Columns]
    FORM_RD2 --> SEL_RD2[Select Columns 2]
    SEL_RD1 --> APP_RD[Append Rows 1]
    SEL_RD2 --> APP_RD
    APP_RD -->|FONTE_DADOS_2='DH'| CONST_RD[FONTE DADOS 1]
    CONST_RD -->|Left Join EAN = prod_code| JOIN_DEPARA[Join Data 5]
    L4 --> JOIN_DEPARA
    JOIN_DEPARA -->|EAN_DEPARA Mapping| EAN_MAP[Add Formula 5]
    EAN_MAP --> SEL_RD5[Select Columns 5]
    SEL_RD5 --> PAD_RD[PADRONIZAÇÕES EAN TIRA 0 DA ESQUERDA 1]

    %% Store join & Carrefour
    DN_1 --> APP_STORE_STREAM[Append Rows]
    PAD_RD --> APP_STORE_STREAM
    L1 -->|LPAD Store Cod| PAD_STORE_COD[PADRONIZAÇÃO STORE COD]
    APP_STORE_STREAM -->|Left Join CUSTOMER, BANNER, STORE_COD| JOIN_STORES[JOIN MASTER LOJAS]
    PAD_STORE_COD --> JOIN_STORES
    JOIN_STORES -->|Validate Key Drops| KEY_VAL[MASTER STORE KEY VALIDATION]

    %% Main enrichment (the Carrefour branch and APPEND GPA are disabled)
    KEY_VAL --> MAIN_DATES[DATAS]
    MAIN_DATES --> FILT_DATE[FILTRO DATA]
    FILT_DATE --> MAIN_QTR[QUARTER]
    MAIN_QTR --> GRP_LOJAS[COUNT LOJAS]
    MAIN_QTR --> JOIN_LOJAS_CNT[Join Data 1: left outer]
    GRP_LOJAS -->|QUANTIDADE LOJAS = COUNT DISTINCT STORE_COD| JOIN_LOJAS_CNT
    JOIN_LOJAS_CNT -->|DP=1, CATEGORY_NIELSEN=NULL| DP_CONST[DISTRIBUIÇÃO NUMÉRICA E PONDERADA]
    L2 --> REM_DUP_PROD[Remove Duplicates]
    DP_CONST -->|Left Join EAN| JOIN_PROD[JOIN MASTER PRODUCT]
    REM_DUP_PROD --> JOIN_PROD
    L3 --> CONST_EXCL[CONSTANTE EXCLUIR]
    JOIN_PROD -->|Left Join EAN| JOIN_RETIRAR[JOIN PARA RETIRAR]
    CONST_EXCL --> JOIN_RETIRAR
    JOIN_RETIRAR --> RENAME_YM[RENOMEAR YYYYMM PARA YM]
    RENAME_YM -->|EXCLUIR IS NULL| EXCL_EANS[EXCLUIR EANS]
    EXCL_EANS --> SEL_COL1[Select Columns 1]
    SEL_COL1 --> SUB_CAT_INT[SUB_CAT INTERNA]
    SUB_CAT_INT --> SUB_CAT_LIQ[SUB_CAT LIQUIDOS]
    SUB_CAT_LIQ --> FILT_SALES_UNIT[FILTRO SALES UNIT]
    FILT_SALES_UNIT --> ALT_CNPJ[Alter Columns: CNPJs to text]
    ALT_CNPJ --> REP_CANAL[Replace Text CANAL]
    REP_CANAL --> ADD_CLASS_NULL[ADD CLASSIFICATION NO NULL]

    %% Output splits
    ADD_CLASS_NULL --> FILT_STORE_CLASS[FILTRO STORE CLASSIFICATION]
    FILT_STORE_CLASS --> SEL_STORE_CLASS[SELECT STORE CLASSIFICATION]
    SEL_STORE_CLASS --> GRP_STORE_CLASS[Agrupar por]
    GRP_STORE_CLASS --> OUT1[(RCD_TAB_STORE_CLASSIFICATION)]

    ADD_CLASS_NULL --> SEL_CONF[SELECT CONFERENCE]
    SEL_CONF --> FILT_CONF[Filter Rows 1: valid EANs]
    FILT_CONF --> OUT2[(RCD_TAB_CONFERENCE)]

    ADD_CLASS_NULL --> FILT_EAN_VALID[Filter Rows: STORE_COD IS NOT NULL]
    FILT_EAN_VALID --> SEL_COL3[Select Columns 3]
    SEL_COL3 --> GRP_LOJAS_2[COUNT LOJAS 2: Stores Selling EAN]
    SEL_COL3 --> JOIN_LOJAS_2[Join Data 6]
    GRP_LOJAS_2 --> JOIN_LOJAS_2
    JOIN_LOJAS_2 --> GRP_BANNER_SALES[Group By 3: Sales by Banner]
    JOIN_LOJAS_2 --> JOIN_BANNER_SALES[Join Data 3]
    GRP_BANNER_SALES --> JOIN_BANNER_SALES
    JOIN_BANNER_SALES --> GRP_AVG_DIST[Group By 4: Avg Store Dist]
    JOIN_BANNER_SALES --> JOIN_AVG_DIST[Join Data 4]
    GRP_AVG_DIST --> JOIN_AVG_DIST
    JOIN_AVG_DIST --> REM_DUP_FINAL[Remove Duplicates 1]
    REM_DUP_FINAL --> CALC_DOTS[DOTS Formula]
    CALC_DOTS --> OUT3[(RCD_DOT_ANALISE_CUSTOMER)]
