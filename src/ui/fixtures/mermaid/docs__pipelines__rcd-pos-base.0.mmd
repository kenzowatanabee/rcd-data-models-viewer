flowchart TD
    RET[("18 retailer datasets<br/>RCD_T1/T2/T3_*")]
    RD[("RCD_RD_ESTADO_CLUSTER_POS")]
    ATA[("RCD_ATACADÃO")]
    SCN[("RCD_SCANTECH")]
    U1["Append Rows<br/><i>all columns</i>"]
    C1["Add Constants<br/>SOURCE_DATASET = 'CUSTOMER'"]
    C2["Add Constants 1<br/>SOURCE_DATASET_1 / _2"]
    U2["Append Rows 1"]
    F1["Add Formula<br/>UPPER/TRIM, strip EAN zeros,<br/>STORE_COD_KEY, safe pad"]
    S1["Select Columns<br/>13 columns"]
    FR["Filter Rows<br/>SALES_VALUE > 0 AND SALES_UNIT > 0<br/>AND YYYYMM >= 202401"]
    STO[("RCD_MASTER_STORES")]
    SF["Add Formula 1 + Remove Duplicates"]
    J1["Join Data<br/>left on CUSTOMER, BANNER, STORE_COD"]
    M1["Add Formula 2<br/>STORE_MATCHED"]
    PRD[("RCD_MASTER_PRODUCT")]
    PF["Select Columns 1 + Add Formula 3<br/>+ Remove Duplicates 1"]
    J2["Join Data 1<br/>left on EAN"]
    M2["Add Formula 4<br/>PRODUCT_MATCHED"]
    PR[("RCD_PARA_RETIRAR")]
    J3["Add Formula 5 + Add Constants 2 + Join Data 2<br/>+ Filter Rows 1 (EXCLUDE IS NULL)"]
    DT["Add Formula 6 + Filter Rows 2<br/>dates, 3-year window"]
    QL["Group By + Join Data 3<br/>STORE_COUNT, inner"]
    OUT[("RCD_POS_BASE<br/><i>output</i>")]
    RET --> U1
    RD --> U1
    ATA --> U1
    U1 --> C1 --> U2
    SCN --> C2 --> U2
    U2 --> F1 --> S1 --> FR --> J1
    STO --> SF --> J1
    J1 --> M1 --> J2
    PRD --> PF --> J2
    J2 --> M2 --> J3
    PR --> J3
    J3 --> DT --> QL --> OUT
