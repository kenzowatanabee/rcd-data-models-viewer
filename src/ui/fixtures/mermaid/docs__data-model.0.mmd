        string store_cod FK
        string ean FK
        string ym
    }
    RCD_LANCAMENTOS_CP {
        string ean PK "aka RCD LANÇAMENTOS CP"
        string quarter "Lauch_Quarter"
        string type_launch "Lauch_Type"
    }
    RCD_ASSORTMENT_RECOMMENDATIONS {
        string customer PK
        string banner PK
        string cluster_customer PK
        string cluster_size PK
        string ean PK
        int exec_date PK "YYYYMM cycle start"
        int exec "2 list, 1 keep, 0 delist"
    }
    RCD_ASSORTMENT_COMPLIANCE_TABLE {
        int ym_sales PK
        string customer PK
        string banner PK
        string cluster_customer PK
        string cluster_size PK
        string ean PK, FK
    }
