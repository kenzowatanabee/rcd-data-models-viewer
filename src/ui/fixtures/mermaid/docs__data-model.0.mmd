        string ym PK
        string area PK
        string canal PK
        string ean PK, FK
    }
    RCD_NIELSEN_ST {
        string ym PK
        string area PK
        string mercado_nielsen PK
        string canal PK
        string ean PK, FK
    }
    RCD_DN_DP_EAN_NIQ {
        string yyyymm PK
