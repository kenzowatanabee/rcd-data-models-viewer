        string banner FK
        string store_cod FK
    }
    RCD_SORT_REC {
        string ean PK
        string quarter PK "e.g. 25 - Q1"
    }
    DE_PARA_RD {
        string prod_code PK "RD product code"
        string scan_type_code FK "EAN; read as decimal (.0)"
    }
    RCD_DOT_ANALISE_CUSTOMER {
        string customer PK, FK
        string banner PK, FK
        string store_cod PK, FK
        string ean PK, FK
        string ym PK
    }
