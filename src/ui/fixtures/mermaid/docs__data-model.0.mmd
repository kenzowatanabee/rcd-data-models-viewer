    PRODUCT_DIMENSION {
        string ean PK "aka RCD_MASTER_PRODUCT; not unique, flows dedupe"
    }
    STORE_DIMENSION {
        string customer PK "aka RCD_MASTER_STORES"
        string banner PK
        long store_cod PK "LONG in Domo: no leading zeros"
        long store_cnpj "used by Scanntech join"
        string area "used by MKT join"
        string canal "used by MKT join"
    }
    CUSTOMER_POS_DATA {
        string YYYYMM PK
        string ean PK, FK
        string customer PK, FK
        string banner PK, FK
        string store_cod PK, FK
    }
