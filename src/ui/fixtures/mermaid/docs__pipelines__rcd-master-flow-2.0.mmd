flowchart TD
    subgraph Input_Retailers ["Retailer Sales Data"]
        R1[RCD_T1_ATACADAO NORTE]
        R2[RCD_ATACADÃO]
        R3[RCD_T1_SÃO_VICENTE]
        R4[RCD_T1_SAVEGNAGO]
        R5[RCD_T2_GPA]
        R6[RCD_T2_ANGELONI]
        R7[RCD_T2_CONDOR]
        R8[RCD_T2_GIASSI]
        R9[RCD_T2_MUFFATO]
        R10[RCD_T2_REDE TOP]
        R11[RCD_T3_D1000]
        R12[RCD_T3_DROGAL]
        R13[RCD_T3_DPSP]
        R14[RCD_T3_DROG PAGUEMENOS]
        R15[RCD_T3_PANVEL]
        R16[RCD_T3_VENANCIO]
        R17[RCD_T3_GLOBO]
        R18[RCD_T3_INDIANA]
        R19[RCD_T3_ARAUJO]
    end

    subgraph Input_Special ["Special Streams"]
        S1[RCD_SCANTECH]
        RD1[RCD_T3_RD ESTADO]
        RD2[RCD_T3_RD CLUSTER]
    end

    subgraph Input_Lookups ["Lookups & Masters"]
        L1[DE PARA RD]
        L2[RCD_MASTER_STORES]
        L3[RCD_MASTER_PRODUCT]
        L4[RCD_PARA_RETIRAR]
        L5[RCD_SORT_REC]
        L6[RCD_TAB_MKT_P_MASTER_FLOW]
        L7[RCD_TAB_IQVIA_P_MASTER_FLOW]
    end

    %% Customer branch
    Input_Retailers -->|Union| UNION_CUST[ANEXAR CUSTOMER N REC]
    UNION_CUST -->|Filter YYYYMM >= 202201 & NOT NULL Sales| FILT_SALES[FILTRO SALES]
    S1 -->|Select Columns| SCAN_SEL[Select Columns]
    SCAN_SEL -->|FONTE_DADOS_2='SCANNTECH'| SCAN_CONST[Add Constants]
    FILT_SALES --> APPEND1[Append Rows 4]
    SCAN_CONST --> APPEND1
    APPEND1 -->|SALES_VOL->SALES_UNIT, DESC_SKU->CONF_DESC_SKU| RENAME1[RENOMEAR UNITS E CONF_DESC]
    RENAME1 -->|Add DN=1| DN1[DISTRIBUIÇÃO NUMÉRICA]
    DN1 -->|LPAD Store, UPPER Customer/Banner, Trim EAN| PAD1[PADRONIZAÇÕES EAN TIRA 0]

    %% RD branch
    RD1 --> TAB_RD_EST[TABELA RD ESTADO]
    RD2 --> TAB_RD_CLUS[TABELA RD CLUSTER 1]
    TAB_RD_EST -->|Max LOJAS VENDENDO per YYYYMM| GRP_RD1[Group By]
    TAB_RD_CLUS -->|Max LOJAS VENDENDO per YYYYMM| GRP_RD2[Group By 1]
    TAB_RD_EST -->|Left Join YYYYMM| JOIN_RD1[Join Data 4]
    GRP_RD1 --> JOIN_RD1
    JOIN_RD1 -->|DN = LOJAS VENDENDO / MAX| FORM_RD1[Add Formula 1]
    TAB_RD_CLUS -->|Left Join YYYYMM| JOIN_RD2[Join Data 5]
    GRP_RD2 --> JOIN_RD2
    JOIN_RD2 -->|DN = LOJAS VENDENDO / MAX| FORM_RD2[Add Formula 2]
    FORM_RD1 --> SEL_RD1[Select Columns 2]
    FORM_RD2 --> SEL_RD2[Select Columns 3]
    SEL_RD1 --> APP_RD[Append Rows 1]
    SEL_RD2 --> APP_RD
    APP_RD -->|FONTE_DADOS='CUSTOMER'| CONST_RD[FONTE DADOS 1]
    CONST_RD -->|Left Join EAN = prod_code| JOIN_DEPARA[Join Data 3]
    L1 --> JOIN_DEPARA
    JOIN_DEPARA -->|EAN_DEPARA Case| EAN_MAP[Add Formula 5]
    EAN_MAP --> SEL_RD4[Select Columns 4]
    SEL_RD4 --> PAD_RD[PADRONIZAÇÕES EAN TIRA 0 DA ESQUERDA 1]

    %% Main retail stream
    PAD1 --> APP_MAIN[Append Rows 2]
    PAD_RD --> APP_MAIN
    L2 -->|LPAD STORE_COD| STORE_PAD[PADRONIZAÇÃO STORE COD]
    APP_MAIN -->|Left Join STORE_COD, BANNER, CUSTOMER| JOIN_STORES[JOIN MASTER LOJAS]
    STORE_PAD --> JOIN_STORES
    JOIN_STORES --> DATAS_MAIN[DATAS]
    DATAS_MAIN --> FILT_DATA[FILTRO DATA]
    FILT_DATA --> QUARTER_MAIN[QUARTER]
    QUARTER_MAIN --> GRP_LOJAS[COUNT LOJAS]
    QUARTER_MAIN --> JOIN_COUNT[Join Data: inner]
    GRP_LOJAS -->|QUANTIDADE LOJAS = COUNT DISTINCT STORE_COD| JOIN_COUNT
    JOIN_COUNT -->|DP=1, CATEGORY_NIELSEN=NULL| DP_CONST[DISTRIBUIÇÃO NUMÉRICA E PONDERADA]
    L3 --> REM_DUP[Remove Duplicates]
    DP_CONST -->|Left Join EAN| JOIN_PROD[JOIN MASTER PRODUCT]
    REM_DUP --> JOIN_PROD
    L4 --> CONST_EXCL[CONSTANTE EXCLUIR]
    JOIN_PROD -->|Left Join EAN| JOIN_RETIRAR[JOIN PARA RETIRAR]
    CONST_EXCL --> JOIN_RETIRAR
    JOIN_RETIRAR --> YM_RENAME[RENOMEAR YYYYMM PARA YM]
    YM_RENAME -->|EXCLUIR IS NULL| EXCL_EANS[EXCLUIR EANS]
    EXCL_EANS --> SEL_COL1[Select Columns 1]

    %% Market append
    L6 --> MKT_DATE[ADD MONTH_NAME]
    MKT_DATE --> MKT_CONST[IDENTIFICAÇÃO 1]
    SEL_COL1 --> APP_MKT[APPEND TAB BASE MKT]
    MKT_CONST --> APP_MKT
    L7 --> APP_MKT
    APP_MKT --> SUB_CAT_INT[SUB_CAT_INTERNO]
    SUB_CAT_INT --> SUB_CAT_LIQ[SUB_CAT_LIQUIDOS]
    SUB_CAT_LIQ --> REP_CANAL[Replace Text CANAL]
    REP_CANAL --> ALT_EAN[Alter Columns 1: YM to integer]
    ALT_EAN --> GRP_EAN[Group By 4: EAN First/Last Month]
    REP_CANAL --> JOIN_EAN_MTH[Join Data 7]
    GRP_EAN --> JOIN_EAN_MTH
    JOIN_EAN_MTH --> ALT_STR[Alter Columns: YM to integer]
    ALT_STR --> GRP_STR[Group By 2: Store First/Last Month]
    JOIN_EAN_MTH --> JOIN_STR_MTH[Join Data 2]
    GRP_STR --> JOIN_STR_MTH
    JOIN_STR_MTH --> FORM_12M[Add Formula 3: 12 MONTHS SELL]
    FORM_12M --> ORIGEM_FORM[FORMULA ORIGEM_DADOS]

    %% Output split
    ORIGEM_FORM --> FILT_PROD_NULL[FILTRO PROD CLASSIFICATION]
    ORIGEM_FORM --> FILT_NOT_NULL[FILTRO IS NOT NULL]
    ORIGEM_FORM --> FILT_RD_CLUS[Filter Rows 1]

    FILT_PROD_NULL --> SEL_PROD_CLASS[SELECT PROD CLASSIFICATION]
    SEL_PROD_CLASS --> YM_DECIMAL[Adicionar fórmula 1]
    YM_DECIMAL --> GRP_PROD_CLASS[Agrupar por]
    GRP_PROD_CLASS --> LAST_YM_STR[Adicionar fórmula 2]
    LAST_YM_STR --> OUT1[(RCD_TAB_PROD_CLASSIFICATION)]

    FILT_NOT_NULL --> APP_CUST_RES[Append Rows]
    FILT_RD_CLUS --> APP_CUST_RES
    APP_CUST_RES --> FILT_2YRS[FILTRAR OS DOIS ULTIMOS ANOS]
    L5 --> UNPIVOT_SORT[Unpivot CANAL / REC_RETAIL]
    FILT_2YRS -->|Left Join EAN, QUARTER, CANAL| JOIN_SORT[Join Data 1]
    UNPIVOT_SORT --> JOIN_SORT
    JOIN_SORT --> FORM_CUST_METRICS[Add Formula: PRECO_MEDIO, SALES_VOL]
    FORM_CUST_METRICS --> SEL_DIAG[SELECT CUSTOMER DIAGNOSTIC]
    SEL_DIAG --> GRP_DIAG[COUNT LOJAS 2]
    SEL_DIAG --> JOIN_DIAG[Join Data 6]
    GRP_DIAG --> JOIN_DIAG
    JOIN_DIAG --> FORM_DN_CUST[Add Formula 4: DN_CUSTOMER]
    FORM_DN_CUST --> REM_DUP_FINAL[Remove Duplicates 1]
    REM_DUP_FINAL --> OUT2[(RCD_TAB_MKT_CUSTOMER_RESUMO)]
