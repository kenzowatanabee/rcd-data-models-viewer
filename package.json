{
  "name": "rcd-data-models-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "index": "tsx src/indexer/cli.ts",
    "check": "prettier --ignore-unknown --check . && eslint && pnpm typecheck && pnpm test:ci",
    "format": "prettier --ignore-unknown --write .",
    "lint": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run --no-color"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^2.1.9"
  }
}
